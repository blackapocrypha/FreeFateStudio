# ============================================================
# 本地配置
# 仓库里的 .env 是占位符模板（DEEPSEEK_API_KEY=xxx），因此纳入版本管理。
# 真实密钥请写到下面两个位置之一，它们不会被提交：
#   .env.local                        项目内，覆盖 .env
#   %LOCALAPPDATA%\FreeFateStudio\.env  用户级，优先级最高
# ============================================================
.env.local
.env.*.local

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# 虚拟环境
.venv/
venv/
env/
ENV/
.conda/

# 打包与构建中间产物
build/
dist/
dist-*/
develop-eggs/
*.egg-info/
.eggs/

# PyInstaller
*.manifest
# build.py 挪开的上一版产物，如 dist/FreeFateStudio.prev-1028140353
*.prev-*
warn-*.txt
xref-*.html

# 测试与缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ============================================================
# 运行期数据（SQLite 会话库、检查点、日志）
# 默认落在 %LOCALAPPDATA%\FreeFateStudio，这里兜住本地调试时生成的那份
# ============================================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
error.log

# ============================================================
# 工具与平台缓存
# ============================================================
# WorkBuddy 的项目记忆 / 会话数据
.workbuddy/
# LangGraph 本地开发服务缓存
.langgraph_api/
.langgraph/
# Jupyter
.ipynb_checkpoints/
# 本地服务器信息
.langgraph_service_info.json

# ============================================================
# 测试截图（体积大且每次跑都会变，README 里用的三张图在根目录，不在此列）
# ============================================================
shots/
exe_running.png
*_shot_*.png
tmp_*.png

# ============================================================
# 编辑器 / IDE
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~

# ============================================================
# 操作系统
# ============================================================
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
